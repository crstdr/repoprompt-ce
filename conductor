#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# /usr/bin/python3 is an xcrun shim that injects SDKROOT=<default SDK> into python3 when SDKROOT
# is unset, and conductor forwards SDKROOT to every job. When the Command Line Tools ship a newer
# SDK than the selected Xcode's compiler (for example CLT 27 next to Xcode 26.5), that default SDK
# cannot be used by the compiler. Pin the selected Xcode's (or DEVELOPER_DIR's) macOS SDK first
# (the same SDK SwiftPM resolves itself when SDKROOT is unset); never override a value the user set.
# Only pin when the selected developer directory is the full Xcode that
# Scripts/resolve_full_xcode_developer_dir.sh (used by release installs) would also choose: with the
# Command Line Tools or a too-old Xcode selected, leave SDKROOT alone so a later full-Xcode
# resolution is never handed a mismatched pinned SDK.
if [[ -z "${SDKROOT:-}" ]] && command -v xcrun >/dev/null 2>&1; then
    selected_developer_dir="${DEVELOPER_DIR:-$(xcode-select --print-path 2>/dev/null || true)}"
    installer_developer_dir="$("$SCRIPT_DIR/Scripts/resolve_full_xcode_developer_dir.sh" 2>/dev/null || true)"
    if [[ -n "$selected_developer_dir" && "$installer_developer_dir" == "$selected_developer_dir" ]] \
        && resolved_sdkroot="$(xcrun --sdk macosx --show-sdk-path 2>/dev/null)" \
        && [[ -n "$resolved_sdkroot" && -d "$resolved_sdkroot" ]]; then
        export SDKROOT="$resolved_sdkroot"
    fi
fi
exec python3 "$SCRIPT_DIR/Scripts/conductor.py" "$@"
